{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/indexer-core.js": {
      "maxDuration": 60
    },
    "api/discover.js": {
      "maxDuration": 60
    },
    "api/feed.js": {
      "maxDuration": 60
    },
    "api/creator.js": {
      "maxDuration": 20
    },
    "api/token.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(favicon.png|apple-touch-icon.png|og.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}